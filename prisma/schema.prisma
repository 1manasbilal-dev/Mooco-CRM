generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Lead {
  id            String   @id @default(cuid())
  name          String
  phone         String
  area          String
  address       String   @default("")
  expectedQty   Float    @default(0)
  status        String   @default("New") // New, Contacted, Trial, Converted, Lost
  notes         String   @default("")
  source        String   @default("Walk-in") // Walk-in, Phone, Referral, Online, Ad
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  convertedToId String?  @unique
  customer      Customer? @relation(fields: [convertedToId], references: [id])
}

model Customer {
  id            String   @id @default(cuid())
  name          String
  phone         String
  area          String
  address       String   @default("")
  dailyQty      Float    @default(1)
  milkType      String   @default("Full Cream") // Full Cream, Toned, Double Toned, Skimmed, Buffalo
  pricePerLiter Float    @default(60)
  status        String   @default("Active") // Active, Paused
  deliveryTime  String   @default("Morning") // Morning, Evening, Both
  monthlyBill   Float    @default(0)
  notes         String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deliveries    Delivery[]
  payments      Payment[]
  products      CustomerProduct[]
  vacations     Vacation[]
  sales         Sale[]
  lead          Lead?
}

model Delivery {
  id           String   @id @default(cuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  date         String   // YYYY-MM-DD
  quantity     Float
  status       String   @default("Pending") // Pending, Delivered, Missed, Cancelled
  notes        String   @default("")
  route        String   @default("Route A")
  itemId       String?  // null = milk (customer's plan), otherwise reference to InventoryItem
  isExtra      Boolean  @default(false) // ad-hoc extra delivery not in plan
  pricePerUnit Float    @default(0) // snapshot price at time of delivery
  productName  String   @default("Milk") // denormalized product name for quick display
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Payment {
  id            String   @id @default(cuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  amount        Float
  date          String   // YYYY-MM-DD
  status        String   @default("Completed") // Completed, Pending, Failed
  method        String   @default("Cash") // Cash, UPI, Bank Transfer, Cheque
  invoiceNumber String   @default("")
  period        String   @default("") // e.g. "2025-01" for monthly
  notes         String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model InventoryItem {
  id           String   @id @default(cuid())
  name         String
  category     String   @default("Milk") // Milk, Yogurt, Butter, Cream, Eggs, Paneer, Other
  unit         String   @default("liters") // liters, kg, dozen, pieces
  pricePerUnit Float    @default(0)
  status       String   @default("Active") // Active, Inactive
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sales        Sale[]
  customerProducts CustomerProduct[]
}

model Sale {
  id         String        @id @default(cuid())
  itemId     String
  item       InventoryItem @relation(fields: [itemId], references: [id])
  customerId String?       // optional link to customer
  quantity   Float
  date       String        // YYYY-MM-DD
  notes      String        @default("")
  amount     Float         @default(0) // total amount = quantity * pricePerUnit
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  customer   Customer?     @relation(fields: [customerId], references: [id])
}

model CustomerProduct {
  id         String        @id @default(cuid())
  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id])
  itemId     String
  item       InventoryItem @relation(fields: [itemId], references: [id])
  dailyQty   Float         @default(1)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([customerId, itemId]) // one product per customer
}

model Vacation {
  id        String   @id @default(cuid())
  customerId String
  customer  Customer @relation(fields: [customerId], references: [id])
  startDate String   // YYYY-MM-DD
  endDate   String   // YYYY-MM-DD
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShopSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String @default("")
}

model DailySummary {
  id              String   @id @default(cuid())
  date            String   @unique // YYYY-MM-DD
  totalDeliveries Int      @default(0)
  totalMilkSold   Float    @default(0)
  totalRevenue    Float    @default(0)
  newCustomers    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Area {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MilkType {
  id           String   @id @default(cuid())
  name         String   @unique
  pricePerLiter Float   @default(60)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model DeliveryTime {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String?
  password         String
  role             String    @default("USER") // ADMIN, USER
  permissions      String[]  @default(["dashboard"])
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}
